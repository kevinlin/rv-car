{
  "name": "rv-car",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "check": "vitest run && tsc --noEmit",
    "export": "/Applications/Blender.app/Contents/MacOS/Blender -b model/rv.blend --python-exit-code 1 -P tools/export_modules.py",
    "optimize": "bash tools/optimize.sh",
    "budget": "node tools/check_budget.mjs",
    "dump": "npx --yes tsx tools/dump_placements.ts",
    "starter": "npm run dump && /Applications/Blender.app/Contents/MacOS/Blender -b -P tools/make_starter_blend.py",
    "check:models": "node --test tools/check_models.test.mjs && node tools/check_models.mjs",
    "model": "/Applications/Blender.app/Contents/MacOS/Blender -b model/rv.blend --python-exit-code 1 -P tools/model_interior.py --",
    "bake": "/Applications/Blender.app/Contents/MacOS/Blender -b model/rv.blend --python-exit-code 1 -P tools/bake_ao.py",
    "check:blend": "/Applications/Blender.app/Contents/MacOS/Blender -b model/rv.blend --python-exit-code 1 -P tools/check_blend.py",
    "textures": "node tools/rectify_textures.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@types/node": "^26.4.1",
    "@types/three": "^0.185.4",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
